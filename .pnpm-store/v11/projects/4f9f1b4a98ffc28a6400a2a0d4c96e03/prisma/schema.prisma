generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  ADMIN
  SUCURSAL
  CAMIONERO
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
  TRASLADO
  VENTA
  COMPRA
  DEVOLUCION
}

enum DocumentStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

enum DeliveryStatus {
  PENDIENTE
  ASIGNADA
  EN_CAMINO
  ENTREGADA
  NO_ENTREGADA
  CANCELADA
}

enum TransferStatus {
  PENDIENTE
  ENVIADO
  RECIBIDO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
  MIXTO
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id            String              @id @default(cuid())
  name          String
  code          String              @unique
  address       String?
  phone         String?
  active        Boolean             @default(true)
  users         User[]
  inventories   Inventory[]
  movements     InventoryMovement[]
  sales         Sale[]
  purchases     Purchase[]
  deliveries    Delivery[]
  cashRegisters CashRegister[]
  expenses      Expense[]
  transfersFrom Transfer[]          @relation("TransferOrigin")
  transfersTo   Transfer[]          @relation("TransferDestination")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  email              String?             @unique
  passwordHash       String
  name               String
  active             Boolean             @default(true)
  mustChangePassword Boolean             @default(false)
  roleId             String
  role               Role                @relation(fields: [roleId], references: [id])
  branchId           String?
  branch             Branch?             @relation(fields: [branchId], references: [id])
  driver             Driver?
  sales              Sale[]
  purchases          Purchase[]
  movements          InventoryMovement[]
  saleReturns        SaleReturn[]
  auditLogs          AuditLog[]
  cashRegisters      CashRegister[]
  transfersCreated   Transfer[]          @relation("TransferCreator")
  transfersReceived  Transfer[]          @relation("TransferReceiver")
  sessions           Session[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  company   String?
  nit       String?    @unique
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  contact   String?
  notes     String?
  active    Boolean    @default(true)
  products  Product[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Customer {
  id           String     @id @default(cuid())
  name         String
  company      String?
  nit          String?    @unique
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  department   String?
  municipality String?
  reference    String?
  notes        String?
  active       Boolean    @default(true)
  sales        Sale[]
  deliveries   Delivery[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Product {
  id             String              @id @default(cuid())
  sku            String              @unique
  barcode        String?             @unique
  name           String
  description    String?
  brand          String?
  unit           String              @default("unidad")
  purchasePrice  Decimal             @default(0) @db.Decimal(12, 2)
  salePrice      Decimal             @default(0) @db.Decimal(12, 2)
  wholesalePrice Decimal             @default(0) @db.Decimal(12, 2)
  minStock       Decimal             @default(0) @db.Decimal(12, 3)
  maxStock       Decimal?            @db.Decimal(12, 3)
  active         Boolean             @default(true)
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id])
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  inventory      Inventory[]
  movements      InventoryMovement[]
  saleItems      SaleItem[]
  saleReturnItems SaleReturnItem[]
  purchaseItems  PurchaseItem[]
  wood           WoodProduct?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([name])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  product   Product  @relation(fields: [productId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
}

model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  branchId  String
  userId    String?
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 3)
  reason    String?
  reference String?
  product   Product      @relation(fields: [productId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
}

model WoodProduct {
  id           String   @id @default(cuid())
  productId    String   @unique
  woodType     String
  dimensions   String?
  length       Decimal? @db.Decimal(10, 2)
  width        Decimal? @db.Decimal(10, 2)
  thickness    Decimal? @db.Decimal(10, 2)
  observations String?
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String         @id @default(cuid())
  number        String         @unique
  branchId      String
  customerId    String?
  userId        String
  subtotal      Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paid          Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        DocumentStatus @default(PENDIENTE)
  dueDate       DateTime?
  branch        Branch         @relation(fields: [branchId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  items         SaleItem[]
  payments      SalePayment[]
  returns       SaleReturn[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[]
}

model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  userId    String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  note      String?
  sale      Sale          @relation(fields: [saleId], references: [id])
  createdAt DateTime      @default(now())
}

model SaleReturn {
  id        String           @id @default(cuid())
  saleId    String
  userId    String
  reason    String
  total     Decimal          @db.Decimal(12, 2)
  sale      Sale             @relation(fields: [saleId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  items     SaleReturnItem[]
  createdAt DateTime         @default(now())

  @@index([saleId, createdAt])
}

model SaleReturnItem {
  id           String    @id @default(cuid())
  returnId     String
  saleItemId   String
  productId    String
  quantity     Decimal   @db.Decimal(12, 3)
  amount       Decimal   @db.Decimal(12, 2)
  saleReturn   SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([returnId, saleItemId])
}

model Purchase {
  id            String            @id @default(cuid())
  number        String            @unique
  invoiceNumber String?
  branchId      String
  supplierId    String
  userId        String
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  paid          Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        DocumentStatus    @default(PENDIENTE)
  dueDate       DateTime?
  branch        Branch            @relation(fields: [branchId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  items         PurchaseItem[]
  payments      PurchasePayment[]
  createdAt     DateTime          @default(now())

  @@index([branchId, createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model PurchasePayment {
  id         String        @id @default(cuid())
  purchaseId String
  userId     String
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  note       String?
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])
  createdAt  DateTime      @default(now())
}

model Driver {
  id            String     @id @default(cuid())
  userId        String     @unique
  phone         String?
  dpi           String?
  licenseType   String?
  licenseNumber String?
  vehicleType   String?
  plate         String?
  notes         String?
  user          User       @relation(fields: [userId], references: [id])
  deliveries    Delivery[]
  routes        Route[]
}

model Delivery {
  id           String         @id @default(cuid())
  number       String         @unique
  customerId   String
  branchId     String
  driverId     String?
  routeId      String?
  address      String
  phone        String?
  observations String?
  status       DeliveryStatus @default(PENDIENTE)
  scheduledAt  DateTime?
  customer     Customer       @relation(fields: [customerId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])
  driver       Driver?        @relation(fields: [driverId], references: [id])
  route        Route?         @relation(fields: [routeId], references: [id])
  items        DeliveryItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model DeliveryItem {
  id          String   @id @default(cuid())
  deliveryId  String
  productName String
  quantity    Decimal  @db.Decimal(12, 3)
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Route {
  id           String     @id @default(cuid())
  name         String
  driverId     String?
  date         DateTime
  status       String     @default("PLANIFICADA")
  observations String?
  driver       Driver?    @relation(fields: [driverId], references: [id])
  deliveries   Delivery[]
  createdAt    DateTime   @default(now())
}

model CashRegister {
  id         String         @id @default(cuid())
  branchId   String
  userId     String
  opening    Float
  closing    Float?
  expected   Float?
  difference Float?
  notes      String?
  openedAt   DateTime       @default(now())
  closedAt   DateTime?
  branch     Branch         @relation(fields: [branchId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  movements  CashMovement[]

  @@index([branchId, closedAt])
}

model CashMovement {
  id             String        @id @default(cuid())
  cashRegisterId String
  kind           String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(EFECTIVO)
  description    String?
  reference      String?
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())
}

model Expense {
  id          String        @id @default(cuid())
  category    String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  branchId    String
  userId      String
  method      PaymentMethod @default(EFECTIVO)
  notes       String?
  branch      Branch        @relation(fields: [branchId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([branchId, createdAt])
}

model Transfer {
  id            String         @id @default(cuid())
  number        String         @unique
  originId      String
  origin        Branch         @relation("TransferOrigin", fields: [originId], references: [id])
  destinationId String
  destination   Branch         @relation("TransferDestination", fields: [destinationId], references: [id])
  status        TransferStatus @default(PENDIENTE)
  userId        String
  user          User           @relation("TransferCreator", fields: [userId], references: [id])
  receivedBy    String?
  receiver      User?          @relation("TransferReceiver", fields: [receivedBy], references: [id])
  items         Json
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  recordId  String?
  details   Json?
  ip        String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([module, recordId])
}

model CompanySettings {
  id        String   @id @default("default")
  name      String   @default("Ferretería")
  nit       String?
  phone     String?
  email     String?
  address   String?
  currency  String   @default("GTQ")
  taxRate   Decimal  @default(0) @db.Decimal(5, 2)
  logoUrl   String?
  updatedAt DateTime @updatedAt
}
